# ── Supabase（東京區，C5）───────────────────────────────
# 值從 Supabase 後台取得（見 00_README 開發指南）；本檔為範本，
# 複製為 .env 後填入真實值。.env 已在 .gitignore，絕不進版控。

# Postgres 連線字串：後台頂部「連接（Connect）」→ Transaction pooler URI
DATABASE_URL=postgresql://postgres.xxxx:密碼@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 專案網址：設定 → 資料 API
SUPABASE_URL=https://xxxx.supabase.co

# 公開金鑰（anon / publishable）：設定 → API金鑰
SUPABASE_ANON_KEY=eyJ...

# 機密金鑰（service_role / secret）：設定 → API金鑰。只給後端／Worker，絕不進前端
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 瀏覽器端用（KB-012：密碼重設走瀏覽器端 implicit flow）。
# 值與上面 SUPABASE_URL／SUPABASE_ANON_KEY 完全相同——anon/publishable key
# 設計上就是給前端用的，不是機密；NEXT_PUBLIC_ 前綴是 Next.js 讓變數進瀏覽器端的規則。
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── 後續 Sprint 才需要（現在留空即可）───────────────────
# Google OAuth（E1-F3）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LLM（E4-F3，OpenAI Responses API）
# OPENAI_API_KEY=
