{
  "openapi": "3.1.0",
  "info": {
    "title": "個人健康檢查管理平台 API",
    "version": "0.1.0",
    "description": "MVP API。錯誤一律回統一 error envelope（{ error: { code, message }, request_id }）。業務端點隨各 Feature 增補（SDD §4）。"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "註冊（含條款同意 C11；既有帳號回 409 EMAIL_EXISTS）",
        "responses": {
          "200": { "description": "已建立並寄出驗證信" },
          "400": { "description": "缺欄位／未同意／弱密碼（ErrorEnvelope）" },
          "409": { "description": "EMAIL_EXISTS（ErrorEnvelope）" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "登入（C6 未驗證可登入；C7 鎖定回 429；設定 HttpOnly session cookie）",
        "responses": {
          "200": { "description": "登入成功，回 emailVerified 旗標" },
          "401": { "description": "AUTH_INVALID_CREDENTIALS（統一訊息防枚舉）" },
          "429": { "description": "AUTH_LOCKED（C7）" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "登出（撤銷 session＋清 cookie；冪等）",
        "responses": { "200": { "description": "已登出" } }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "operationId": "forgotPassword",
        "summary": "寄送重設信（C9；一律回成功防枚舉）",
        "responses": { "200": { "description": "已受理" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getMe",
        "summary": "目前登入者（session 驗證＋滑動展延 C8）",
        "responses": {
          "200": { "description": "email 與 emailVerified" },
          "401": { "description": "AUTH_REQUIRED（ErrorEnvelope）" }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "健康檢查（Web 進程存活）",
        "responses": {
          "200": {
            "description": "服務正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "request_id"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "request_id": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
