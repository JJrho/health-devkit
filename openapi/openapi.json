{
  "openapi": "3.1.0",
  "info": {
    "title": "個人健康檢查管理平台 API",
    "version": "0.1.0",
    "description": "MVP API。錯誤一律回統一 error envelope（{ error: { code, message }, request_id }）。業務端點隨各 Feature 增補（SDD §4）。"
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "健康檢查（Web 進程存活）",
        "responses": {
          "200": {
            "description": "服務正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "request_id"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "request_id": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
