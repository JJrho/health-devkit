{
  "openapi": "3.1.0",
  "info": {
    "title": "個人健康檢查管理平台 API",
    "version": "0.1.0",
    "description": "MVP API。錯誤一律回統一 error envelope（{ error: { code, message }, request_id }）。業務端點隨各 Feature 增補（SDD §4）。"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "註冊（含條款同意 C11；既有帳號回 409 EMAIL_EXISTS）",
        "responses": {
          "200": { "description": "已建立並寄出驗證信" },
          "400": { "description": "缺欄位／未同意／弱密碼（ErrorEnvelope）" },
          "409": { "description": "EMAIL_EXISTS（ErrorEnvelope）" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "登入（C6 未驗證可登入；C7 鎖定回 429；設定 HttpOnly session cookie）",
        "responses": {
          "200": { "description": "登入成功，回 emailVerified 旗標" },
          "401": { "description": "AUTH_INVALID_CREDENTIALS（統一訊息防枚舉）" },
          "429": { "description": "AUTH_LOCKED（C7）" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "登出（撤銷 session＋清 cookie；冪等）",
        "responses": { "200": { "description": "已登出" } }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "operationId": "forgotPassword",
        "summary": "寄送重設信（C9；一律回成功防枚舉）",
        "responses": { "200": { "description": "已受理" } }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getMe",
        "summary": "目前登入者（session 驗證＋滑動展延 C8；附最近存取專案 id）",
        "responses": {
          "200": { "description": "email、emailVerified、mostRecentProjectId" },
          "401": { "description": "AUTH_REQUIRED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects": {
      "post": {
        "operationId": "createProject",
        "summary": "建立健康專案（AC-1；C6 未驗證亦可建立）",
        "responses": {
          "200": { "description": "已建立，owner＝目前登入者、version=1" },
          "400": { "description": "缺專案名稱（ErrorEnvelope）" },
          "401": { "description": "AUTH_REQUIRED（ErrorEnvelope）" }
        }
      },
      "get": {
        "operationId": "listProjects",
        "summary": "專案列表（AC-2；排除已刪除，附最近存取專案 id）",
        "responses": {
          "200": { "description": "items＋mostRecentProjectId" },
          "401": { "description": "AUTH_REQUIRED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "operationId": "getProject",
        "summary": "取得單一專案（四層權限鏈；標記最近存取）",
        "responses": {
          "200": { "description": "專案內容" },
          "401": { "description": "AUTH_REQUIRED（ErrorEnvelope）" },
          "403": { "description": "PROJECT_ACCESS_DENIED（AC-6，跨帳號一律拒絕＋稽核）" }
        }
      },
      "patch": {
        "operationId": "renameProject",
        "summary": "改名（AC-3；OCC 樂觀鎖，version 不符回 409）",
        "responses": {
          "200": { "description": "已更新，version+1" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" },
          "409": { "description": "VERSION_CONFLICT（ErrorEnvelope，不靜默覆寫）" }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "刪除（AC-5；任一非刪除狀態→deleted，軟刪除）",
        "responses": {
          "200": { "description": "已刪除" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/archive": {
      "post": {
        "operationId": "archiveProject",
        "summary": "封存（AC-4；active→archived，已封存者冪等成功）",
        "responses": {
          "200": { "description": "已封存" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/restore": {
      "post": {
        "operationId": "restoreProject",
        "summary": "還原（AC-4；archived→active，已是 active 者冪等成功；deleted 不可還原）",
        "responses": {
          "200": { "description": "已還原" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "取得個人健康背景（AC-1／AC-7；尚未建立回 profile:null，非 404）",
        "responses": {
          "200": { "description": "profile 內容或 null" },
          "401": { "description": "AUTH_REQUIRED（ErrorEnvelope）" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      },
      "put": {
        "operationId": "upsertProfile",
        "summary": "建立或更新個人健康背景（AC-2／AC-3；autosave＋OCC 樂觀鎖）",
        "responses": {
          "200": { "description": "已儲存，version+1" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" },
          "409": { "description": "VERSION_CONFLICT（ErrorEnvelope，不靜默覆寫）" }
        }
      }
    },
    "/api/projects/{id}/documents": {
      "get": {
        "operationId": "listDocuments",
        "summary": "文件列表（排除已刪除）",
        "responses": {
          "200": { "description": "items" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/documents/upload-sessions": {
      "post": {
        "operationId": "createUploadSession",
        "summary": "建立上傳會話（AC-1／AC-2；同 idempotencyKey 冪等；C6 未驗證鎖定；C12 份數上限）",
        "responses": {
          "200": { "description": "document（status=uploading）" },
          "400": { "description": "INVALID_REQUEST／DOCUMENT_QUOTA_EXCEEDED（ErrorEnvelope）" },
          "403": { "description": "PROJECT_ACCESS_DENIED／EMAIL_VERIFICATION_REQUIRED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/documents/{documentId}/parts/{partNumber}": {
      "put": {
        "operationId": "uploadPart",
        "summary": "上傳分段（AC-3；同號覆寫，天然支援重試）",
        "responses": {
          "200": { "description": "已收到" },
          "400": { "description": "INVALID_REQUEST（會話非 uploading 狀態）" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/documents/{documentId}/complete": {
      "post": {
        "operationId": "completeUpload",
        "summary": "完成上傳（AC-3～AC-5；串接分段、驗證實際內容、大小/頁數）",
        "responses": {
          "200": { "description": "document（status=uploaded）" },
          "400": { "description": "FILE_TOO_LARGE／FILE_TYPE_NOT_SUPPORTED／FILE_CORRUPTED（ErrorEnvelope）" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/documents/{documentId}": {
      "delete": {
        "operationId": "deleteDocument",
        "summary": "取消或刪除（AC-9；皆軟刪除，同 idempotencyKey 可重傳）",
        "responses": {
          "200": { "description": "document（status=deleted）" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/projects/{id}/documents/{documentId}/preview": {
      "get": {
        "operationId": "getDocumentPreview",
        "summary": "短效 signed URL（AC-10；憲法 §4：不入日誌）",
        "responses": {
          "200": { "description": "url" },
          "400": { "description": "INVALID_REQUEST（尚未完成上傳）" },
          "403": { "description": "PROJECT_ACCESS_DENIED（ErrorEnvelope）" }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "健康檢查（Web 進程存活）",
        "responses": {
          "200": {
            "description": "服務正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "request_id"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "request_id": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          },
          "request_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
